                        </object>
                    </element>
                </point_symbol>
            </symbol>
            <symbol type="1" id="50" code="207.1" name="Boulder cluster, significantly larger">
                <description>To be able to show the distinction between neighbouring (maximum 30 m apart) boulder clusters with significant difference in boulder size, it is permitted to use this symbol instead of regular Boulder cluster (207) for some of the boulder clusters.</description>
                <point_symbol inner_radius="0" inner_color="-1" outer_width="0" outer_color="-1" elements="2">
