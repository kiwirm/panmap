            <symbol type="4" id="61" code="213" name="Sandy ground">
                <description>An area of soft sandy ground where runnability is reduced to less than 80% of normal speed.

The symbol is orientated to north.

Minimum area: 1 mm x 1 mm (footprint 15 m x 15 m).</description>
                <area_symbol inner_color="32" min_area="1000" patterns="1">
                    <pattern type="2" angle="0.785398" no_clipping="1" line_spacing="450" line_offset="0" offset_along_line="0" point_distance="450">
