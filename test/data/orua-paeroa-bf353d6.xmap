            <symbol type="1" id="37" code="203" name="Rocky pit or cave (without a distinct entrance)">
                <description>A rocky pit, hole, cave (without a distinct entrance) or mineshaft which may constitute a danger to the competitor.
Location is the centre of gravity of the symbol.
Minimum depth: 0.5 m.
Footprint: 4.4 m x 5.0 m.</description>
                <point_symbol inner_radius="900" inner_color="-1" outer_width="0" outer_color="-1" elements="1">
                    <element>
                        <symbol type="4" code="">
                            <area_symbol inner_color="4" min_area="0" patterns="0" />
