                    <part symbol="59" />
                    <part symbol="60" />
                </combined_symbol>
            </symbol>
            <symbol type="2" id="59" code="302.1" name="Crossable body of water, border line">
                <description>If no other line symbol touches the border of the passable body of water, the border shall be represented with a blue line.</description>
