            <symbol type="1" id="38" code="203.1" name="Cave (with a distinct entrance)">
                <description>A cave with distinct entrance.
Location is the centre of gravity of the symbol, and the symbol should point into the cave.
Minimum depth: 0.5 m.
Footprint: 4.4 m x 5.0 m.</description>
                <point_symbol rotatable="true" inner_radius="900" inner_color="-1" outer_width="0" outer_color="-1" elements="1">
                    <element>
                        <symbol type="4" code="">
