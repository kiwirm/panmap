            </symbol>
            <symbol type="4" id="56" code="301.3" name="Uncrossable body of water (full colour), fill">
                <description>An area of deep water such as a lake, pond, river or fountain which may constitute
a danger to the competitor. The dark blue colour and the bordering
black line indicate that the feature cannot be crossed.
Dominant areas of water may be shown with 70% colour.
Minimum width: 0.3 mm
Minimum area (inside): 0.5 mm² (footprint 8 m²)</description>
                <area_symbol inner_color="16" min_area="1000" patterns="0" />
            </symbol>
            <symbol type="4" id="57" code="301.4" name="Uncrossable body of water (dominant), fill">
